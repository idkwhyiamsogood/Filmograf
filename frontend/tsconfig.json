{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": "./src",

    "paths": {
      // Основные алиасы для папок
        "@/api/*": ["api/*"],
        "@/components/*": ["components/*"],
        "@/entities/*": ["entities/*"],
        "@/widgets/*": ["widgets/*"],
        "@/shared/*": ["shared/*"],
        "@/features/*": ["features/*"],
        "@/core/*": ["core/*"],
        "@/public/*" : ["../public/*"],
        "@/providers/*" : ["providers/*"],
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules"]
}
