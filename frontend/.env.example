# Base URL the frontend sends API requests to.
# In dev, this should point at the Vite dev server itself (port 3000) — vite.config.ts
# proxies /api/* paths to the appropriate backend microservice on localhost.
# In production this should be the deployed API origin, e.g. https://filmograf.online
#
# When running the Android app against a local dev machine (Capacitor's
# server.url in capacitor.config.ts), use that machine's LAN IP instead of
# localhost, e.g. http://192.168.0.195:3000, and make sure vite.config.ts's
# server.host is enabled so the phone can reach it.
VITE_API_URL=http://localhost:3000
