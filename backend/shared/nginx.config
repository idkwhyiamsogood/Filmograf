# для корректной работы WebSockets или SignalR
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      keep-alive;
}

server {
    server_name filmograf.online www.filmograf.online;

    # Общие настройки для всех прокси-локаций
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    
    # КЛЮЧЕВОЕ ИСПРАВЛЕНИЕ: разрешаем keep-alive до бэкенда
    proxy_set_header Connection $connection_upgrade;
    proxy_cache_bypass $http_upgrade;

    # Настройки буферизации: помогают при ответах > 4кб (твой случай с 26кб)
    proxy_buffering on;
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    proxy_read_timeout 300;
    proxy_send_timeout 300;

    # Auth & Sign-in (Port 5090)
    location ^~ /signin-google {
        proxy_pass http://localhost:5090;
    }

    location ^~ /api/auth/ {
        proxy_pass http://localhost:5090;
    }

    # Comments (Port 5092)
    location ^~ /api/comments/ {
        proxy_pass http://localhost:5092;
    }

    # Genres & Movies (Port 5091)
    location ^~ /api/genres/ {
        proxy_pass http://localhost:5091;
    }

    location ^~ /api/movies/ {
        proxy_pass http://localhost:5091;
    }

    location ^~ /api/search/ {
        proxy_pass http://localhost:5093;
    }

    location ^~ /api/collections/ {
        proxy_pass http://localhost:5094;
    }
}